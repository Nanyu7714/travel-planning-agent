APP_NAME=行旅
DATABASE_URL=sqlite:///../travel.db
APP_BASE_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
CSRF_SECRET=change-this-to-another-long-random-string
ADMIN_INITIAL_PASSWORD=replace-with-a-private-initial-admin-password
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Authentication mail
# Keep "console" for local testing. Change it to "smtp" in your private .env
# when you are ready to send real verification emails through Brevo.
ENVIRONMENT=development
MAIL_DELIVERY_MODE=console
MAIL_FROM=your-verified-sender@example.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-brevo-smtp-login
# Use a Brevo SMTP key, not your Brevo account password or API key.
SMTP_PASSWORD=replace-with-brevo-smtp-key
SMTP_STARTTLS=true
AUTH_EMAIL_TOKEN_MINUTES=30
EMAIL_VERIFICATION_CODE_MINUTES=3
PASSWORD_RESET_TOKEN_MINUTES=30

INLINE_WORKER=true
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=500
AMAP_WEB_SERVICE_KEY=

# Optional photo sources for the admin photo album.
# Leave empty to use Wikimedia Commons only; fill a key to enable that provider.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PHOTO_DOWNLOAD_ENABLED=true
